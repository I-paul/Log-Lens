{
  "manifest_version": 3,
  "name": "Log Lens",
  "version": "0.1.0",
  "description": "Chrome extension for LogLens log monitoring analysis and Root Cause Explanation.",
  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LogLens Capture",
    "default_icon": "Icon Resized.png"
  },
  "icons": {
    "16": "Icon Resized.png",
    "48": "Icon Resized.png",
    "128": "Icon Resized.png"
  }
}